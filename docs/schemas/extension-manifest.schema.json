{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent:extension-manifest:1",
  "title": "Agent offline extension manifest v1",
  "type": "object",
  "required": [
    "formatVersion",
    "publisher",
    "name",
    "displayName",
    "description",
    "version",
    "type",
    "engines",
    "targets",
    "files"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})$"
    },
    "type": {
      "enum": [
        "skill",
        "mcp",
        "plugin"
      ]
    },
    "engines": {
      "type": "object",
      "required": [
        "extensionApi",
        "node",
        "electron",
        "chromium"
      ],
      "properties": {
        "extensionApi": {
          "const": 1
        },
        "node": {
          "const": "16"
        },
        "electron": {
          "const": "22"
        },
        "chromium": {
          "const": "108"
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "any",
          "win32-x64",
          "darwin-arm64",
          "darwin-x64",
          "linux-x64",
          "linux-arm64"
        ]
      }
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2047,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "mcp": {
      "type": "object",
      "required": [
        "transport",
        "permission"
      ],
      "properties": {
        "transport": {
          "enum": [
            "stdio",
            "http"
          ]
        },
        "permission": {
          "enum": [
            "read",
            "write",
            "edit",
            "command"
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "url": {
          "type": "string"
        },
        "bearerTokenEnv": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "transport": {
                "const": "http"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "skill",
              "plugin"
            ]
          }
        }
      },
      "then": {
        "required": [
          "entry"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mcp"
          }
        }
      },
      "then": {
        "required": [
          "mcp"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mcp"
          },
          "mcp": {
            "properties": {
              "transport": {
                "const": "stdio"
              }
            }
          }
        },
        "required": [
          "mcp"
        ]
      },
      "then": {
        "required": [
          "entry"
        ]
      }
    }
  ]
}
