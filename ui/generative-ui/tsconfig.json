{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "../../src/main/contracts/generative-ui.js",
    "../../src/main/contracts/generative-ui-interaction.js"
  ]
}
