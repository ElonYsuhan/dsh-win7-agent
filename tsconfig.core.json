{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "lib": ["ES2020"]
  },
  "include": [
    "src/main/contracts/**/*.js",
    "src/main/flow/**/*.js",
    "src/main/state/**/*.js"
  ]
}
