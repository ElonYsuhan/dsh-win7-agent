{
  "name": "dsh-win7-agent",
  "version": "0.4.3",
  "private": true,
  "description": "Win7-compatible local Agent shell. Local workspace and local commands, remote OpenAI-compatible LLM.",
  "main": "src/main/main.js",
  "author": "Agent",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-runtime-architecture.js && node scripts/runtime-audit-smoke.js && node scripts/cordis-runtime-smoke.js && node scripts/layered-agent-smoke.js && node scripts/check-syntax.js && node scripts/check-win7-compat.js && node scripts/settings-migration-smoke.js && node scripts/renderer-smoke.js && node scripts/check-ui-dialogs.js && node scripts/web-bridge-smoke.js && node scripts/platform-smoke.js && node scripts/ui-store-smoke.js && node scripts/self-validate-smoke.js && node scripts/service-manager-smoke.js && node scripts/installer-smoke.js && node scripts/update-takeover-smoke.js && node scripts/shell-menu-smoke.js && node scripts/shell-chrome-smoke.js && node scripts/navigation-guard-smoke.js && node scripts/window-controls-smoke.js && node scripts/plugin-smoke.js && node scripts/mcp-smoke.js && node scripts/knowledge-native-smoke.js && node scripts/knowledge-smoke.js && node scripts/knowledge-session-smoke.js && node scripts/workflows-smoke.js && node scripts/document-mcp-smoke.js && node scripts/agent-smoke.js && node scripts/llm-stream-smoke.js && node scripts/concurrency-smoke.js && node scripts/server-concurrency-smoke.js && node scripts/release-retention-smoke.js && node scripts/agent-ux-smoke.js && node scripts/tasks-smoke.js && node scripts/task-lifecycle-smoke.js && node scripts/extensions-smoke.js && node scripts/workflow-v2-smoke.js && node scripts/workflow-artifacts-smoke.js && node scripts/workflow-processing-smoke.js && node scripts/workflow-interaction-smoke.js && node scripts/workflow-node-design-smoke.js && node scripts/workflow-routing-smoke.js && node scripts/workflow-schedule-smoke.js && node scripts/workflow-materials-smoke.js",
    "check:audit": "node scripts/runtime-audit-smoke.js",
    "check:win7": "node scripts/check-win7-compat.js",
    "check:renderer": "node scripts/renderer-smoke.js && node scripts/web-bridge-smoke.js",
    "check:platform": "node scripts/platform-smoke.js",
    "check:concurrency": "node scripts/concurrency-smoke.js && node scripts/server-concurrency-smoke.js",
    "check:service": "node scripts/service-manager-smoke.js",
    "check:installer": "node scripts/installer-smoke.js",
    "check:menu": "node scripts/shell-menu-smoke.js",
    "check:navigation:runtime": "node scripts/navigation-guard-runtime-smoke.js",
    "check:menu:runtime": "node scripts/shell-menu-runtime-smoke.js",
    "check:chrome": "node scripts/shell-chrome-smoke.js && node scripts/window-controls-smoke.js",
    "check:drag": "node scripts/shell-drag-smoke.js",
    "check:browser": "node scripts/browser-driver-smoke.js",
    "check:ui": "node scripts/ui-e2e-smoke.js",
    "check:first-chat": "node scripts/first-chat-e2e-smoke.js",
    "check:selfvalidate": "node scripts/self-validate-smoke.js",
    "check:shellpage": "node scripts/shell-page-smoke.js",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:win:portable": "electron-builder --win portable --x64 --publish never",
    "dist:win:dir": "electron-builder --win --x64 --dir --publish never",
    "build:desktop": "node scripts/build-desktop.js all",
    "build:desktop:win": "node scripts/build-desktop.js win-x64",
    "build:desktop:mac": "node scripts/build-desktop.js mac-arm64",
    "build:desktop:linux": "node scripts/build-desktop.js linux-x64",
    "clean:release": "node scripts/clean-release.js",
    "clean:release:dry": "node scripts/clean-release.js --dry-run",
    "make:icons": "python scripts/make-logo.py",
    "smoke:context": "node scripts/context-compression-smoke.js",
    "smoke:permission": "node scripts/permission-smoke.js",
    "check:skills": "node scripts/plugin-smoke.js && node scripts/mcp-smoke.js && node scripts/agent-smoke.js",
    "check:theme": "node scripts/theme-smoke.js",
    "check:runtime": "node scripts/check-runtime-architecture.js && node scripts/runtime-audit-smoke.js && node scripts/cordis-runtime-smoke.js && node scripts/layered-agent-smoke.js",
    "vendor:cordis": "node scripts/vendor-cordis.js",
    "check:node16": "node scripts/check-node16.js",
    "check:ux": "node scripts/agent-ux-smoke.js",
    "check:ux:browser": "node scripts/agent-ux-e2e-smoke.js",
    "check:memory:browser": "node scripts/stream-memory-e2e-smoke.js",
    "check:dialogs:browser": "node scripts/dialog-drag-e2e-smoke.js",
    "check:llm": "node scripts/llm-stream-smoke.js",
    "check:mcp": "node scripts/mcp-smoke.js",
    "check:tasks": "node scripts/tasks-smoke.js && node scripts/task-lifecycle-smoke.js",
    "check:tasks:browser": "node scripts/tasks-e2e-smoke.js",
    "check:documents": "node scripts/document-mcp-smoke.js",
    "check:documents:browser": "node scripts/document-mcp-e2e-smoke.js",
    "check:extensions": "node scripts/extensions-smoke.js",
    "check:extensions:browser": "node scripts/extensions-e2e-smoke.js",
    "check:workflows:v2": "node scripts/workflow-v2-smoke.js",
    "check:workflows:v2:browser": "node scripts/workflow-v2-e2e-smoke.js",
    "check:workflows:interaction": "node scripts/workflow-interaction-smoke.js",
    "check:workflows:browser": "node scripts/workflows-e2e-smoke.js",
    "check:workflows:interaction:browser": "node scripts/workflow-interaction-e2e-smoke.js",
    "check:workflows:canvas:browser": "node scripts/workflow-canvas-e2e-smoke.js",
    "check:workflows:node-design": "node scripts/workflow-node-design-smoke.js",
    "check:workflows:node-design:browser": "node scripts/workflow-node-design-e2e-smoke.js",
    "check:workflows:simulation:browser": "node scripts/workflow-simulation-e2e-smoke.js",
    "check:workflows:routing": "node scripts/workflow-routing-smoke.js",
    "check:workflows:schedule": "node scripts/workflow-schedule-smoke.js",
    "check:workflows:properties:browser": "node scripts/workflow-properties-e2e-smoke.js",
    "check:workflows:materials:browser": "node scripts/workflow-materials-e2e-smoke.js"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.dsh.agent",
    "productName": "Agent",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "server/**/*",
      "shell/menu.js",
      "shell/window-chrome.js",
      "shell/navigation-guard.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "src/main/knowledge/vendor/sqlite/**"
    ]
  }
}
